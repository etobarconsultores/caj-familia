# Copia este archivo como ".env" y completa con los datos de tu proyecto Supabase
# (Project Settings > API en el panel de Supabase).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# ==============================================================================
# Variables de BACKEND (Vercel Functions en /api/google/*) para la integración
# con Google Calendar. NINGUNA de estas debe llevar el prefijo VITE_: si lo
# llevaran, Vite las incluiría en el bundle público del frontend, exponiendo
# secretos. Estas variables NO se usan en local con "npm run dev" salvo que
# uses "vercel dev"; en producción se configuran directamente en Vercel
# (ver README, sección "Google Calendar"), nunca aquí con valores reales.
# ==============================================================================

# Igual que VITE_SUPABASE_URL, pero sin el prefijo VITE_ (el backend no tiene
# acceso a variables VITE_*, que son exclusivas del bundle del frontend).
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Igual que VITE_SUPABASE_ANON_KEY, pero accesible desde el backend.
SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Service Role Key de Supabase (Project Settings > API > service_role).
# SECRETO CRÍTICO: nunca la compartas, nunca la subas a GitHub, nunca le
# pongas el prefijo VITE_. Solo se usa server-side para leer/escribir la
# tabla de tokens de Google, que no tiene políticas RLS para el frontend.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Credenciales OAuth de Google Cloud Console (ver README, sección
# "Configurar Google Cloud Console" para el paso a paso).
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET

# URL exacta configurada en Google Cloud Console como "Authorized redirect
# URI". Debe apuntar a tu dominio de Vercel + /api/google/callback.
GOOGLE_REDIRECT_URI=https://TU-APP.vercel.app/api/google/callback

# URL pública de tu aplicación (sin barra final), usada para volver a
# redirigir el navegador de la usuaria después del flujo OAuth.
APP_URL=https://TU-APP.vercel.app
